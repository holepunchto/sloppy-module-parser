{
  "name": "sloppy-module-parser",
  "version": "2.2.3",
  "description": "Parse imports/exports/requires with a focus on speed over 100% correctness",
  "main": "parse.js",
  "files": [
    "parse.js",
    "sloppy-require-parser.js"
  ],
  "dependencies": {
    "cjs-module-lexer": "^1.2.3",
    "es-module-lexer": "^1.4.1"
  },
  "devDependencies": {
    "brittle": "^3.3.2",
    "lunte": "^1.0.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "prettier --check . && lunte",
    "test": "npm run test:node && npm run test:bare",
    "test:node": "brittle-node test.mjs",
    "test:bare": "brittle-bare test.mjs"
  },
  "repository": {
